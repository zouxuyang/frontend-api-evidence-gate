{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/acceptance-task.schema.json",
  "title": "AcceptanceTask",
  "type": "object",
  "required": [
    "taskId",
    "taskVersion",
    "specId",
    "specVersion",
    "scenarios"
  ],
  "properties": {
    "specId": {
      "type": "string"
    },
    "specVersion": {
      "type": "integer",
      "minimum": 1
    },
    "taskId": {
      "type": "string"
    },
    "taskVersion": {
      "type": "integer",
      "minimum": 1
    },
    "browser": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "launch",
            "existing"
          ]
        },
        "browser": {
          "enum": [
            "chromium",
            "edge",
            "firefox",
            "webkit"
          ]
        },
        "headless": {
          "type": "boolean"
        },
        "connection": {
          "type": "object",
          "required": [
            "type",
            "endpoint"
          ],
          "properties": {
            "type": {
              "const": "cdp"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "tabTitle": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "locator"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "locator": { "$ref": "#/$defs/locator" },
                "description": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "route"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "path"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "action": {
                      "enum": [
                        "open",
                        "attach",
                        "click",
                        "fill",
                        "select",
                        "upload",
                        "press",
                        "waitFor",
                        "screenshot",
                        "assertVisible",
                        "assertText",
                        "assertValue",
                        "assertValidation",
                        "assertRequest",
                        "assertResponse"
                      ]
                    },
                    "target": {
                      "$ref": "#/$defs/locator"
                    },
                    "component": {
                      "type": "string"
                    },
                    "api": {
                      "type": "string"
                    },
                    "expected": {},
                    "value": {},
                    "key": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "timeoutMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "waitUntil": {
                      "enum": ["load", "domcontentloaded", "networkidle"]
                    },
                    "bodyMatch": {
                      "enum": [
                        "exact",
                        "subset"
                      ]
                    },
                    "state": {
                        "enum": [
                        "attached",
                        "detached",
                        "visible",
                          "hidden",
                          "networkidle"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "open": {
                      "type": "string"
                    },
                    "waitUntil": {
                      "enum": ["load", "domcontentloaded", "networkidle"]
                    },
                    "timeoutMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "click": {
                      "type": "object"
                    },
                    "fill": {
                      "type": "object"
                    },
                    "assertVisible": {
                      "type": "object"
                    },
                    "assertRequest": {
                      "type": "object"
                    },
                    "assertResponse": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "screenshot": {
          "enum": [
            "required",
            "each-step",
            "final"
          ]
        },
        "trace": {
          "type": "boolean"
        },
        "consoleErrors": {
          "enum": [
            "ignore",
            "warn",
            "fail"
          ]
        },
        "redactSensitiveData": {
          "type": "boolean"
        },
        "layoutOverflow": {
          "enum": [
            "ignore",
            "fail"
          ]
        },
        "accessibility": {
          "enum": [
            "ignore",
            "fail",
            "axe"
          ]
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "impact"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "testId": { "type": "string" },
        "placeholder": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "css": { "type": "string" },
        "exact": { "type": "boolean" },
        "nth": { "type": "integer", "minimum": 0 },
        "first": { "type": "boolean" },
        "last": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
