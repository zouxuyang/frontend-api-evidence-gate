{
  "name": "@zouxuyang/frontend-api-evidence-gate",
  "version": "0.1.0",
  "description": "Framework-agnostic AI frontend acceptance runner with browser and API evidence.",
  "type": "module",
  "bin": {
    "acceptance-runner": "./dist/cli.js",
    "acceptance-runner-server": "./dist/server.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "plan": "node dist/cli.js plan",
    "acceptance": "node dist/cli.js run"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.2",
    "ajv": "^8.17.1",
    "playwright": "^1.52.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
